# @neondatabase/auth@0.5.0-beta pulls @neondatabase/auth-ui, which pulls
# @daveyplate/better-auth-ui, and those disagree on `better-call` (1.4.0 vs
# 1.3.7 via @better-auth/passkey). The conflict is entirely inside Neon's own
# beta dependency tree, not ours, and npm's strict peer resolution refuses the
# install without this — including in CI.
#
# Note this also stops npm auto-installing peers, which is why `vite` (a peer
# of vitest) is declared explicitly in devDependencies. Drop both once Neon's
# tree is consistent.
legacy-peer-deps=true
