# better-auth declares `vitest` as a peerOptional pinned to ^2 || ^3 || ^4,
# and this project runs vitest 5. The peer is only used by better-auth's own
# test helpers, which we don't import, so the conflict is cosmetic — but npm's
# strict peer resolution refuses the install without this, including in CI.
# Revisit when better-auth widens that range.
legacy-peer-deps=true
