# --- Sarvam (subtitles, study material, doubts, voice) ---
# Server-only key from dashboard.sarvam.ai. Sent as the api-subscription-key header.
SARVAM_API_KEY=

# OpenUI's install script sends anonymous telemetry unless this is set.
# Export it in your shell (it must be present when `npm install` runs).
OPENUI_TELEMETRY_DISABLED=1

# --- Supabase ---
# Postgres via the transaction pooler (Project Settings > Database > Connection
# string > Transaction, port 6543). Used by the app at runtime.
DATABASE_URL=
# The direct connection (port 5432). Used only by `npm run db:migrate`.
DIRECT_URL=

# Project URL and publishable key (Project Settings > API Keys). Both are
# public by design and ship to the browser for sign-in; the NEXT_PUBLIC_
# prefix is what lets Next.js expose them. Every table has row-level security
# with no policies, so this key can't read or write app data. The service-role
# / secret key is never used: don't add it here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google and GitHub sign-in are enabled under Authentication > Sign In /
# Providers. Add <site>/auth/callback to Authentication > URL Configuration >
# Redirect URLs. The sign-in page reads which providers are on from Supabase.

# --- Limits ---
DOUBT_DAILY_LIMIT=20
